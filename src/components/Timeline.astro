---
import { ordered } from '../lib/ordered';
import { sortedExperience } from '../lib/experience';
import { toYear, range } from '../lib/dates';

interface Props {
  /** Compact = one-line short labels (home page); otherwise role + org on two lines */
  compact?: boolean;
}
const { compact = false } = Astro.props;

const experience = await sortedExperience();
const education = await ordered('education');

const now = new Date();
const NOW = now.getFullYear() + now.getMonth() / 12 + 0.04;
const T0 = Math.floor(Math.min(...[...experience, ...education].map((e) => toYear(e.data.start))));
const T1 = Math.floor(NOW) + 1;
const pct = (v: number) => `${(((v - T0) / (T1 - T0)) * 100).toFixed(2)}%`;

// Vertical layout (phones): newest at the top.
const vpct = (v: number) => `${(((T1 - v) / (T1 - T0)) * 100).toFixed(2)}%`;

type Bar = { left: string; width: string; top: string; height: string; kind: string; ongoing: boolean; dates: string; label: { short: string; role: string; org: string } };
const bar = (start: string, end: string | undefined, kind: string, label: Bar['label'], display?: string): Bar => {
  const s = toYear(start);
  const e = Math.min(end ? toYear(end) + 1 / 12 : NOW, NOW);
  return { left: pct(s), width: pct(T0 + e - s), top: vpct(e), height: vpct(T1 - (e - s)), kind, ongoing: !end, dates: range(start, end, display), label };
};

const eduBars = education.map((e) => bar(e.data.start, e.data.end, 'education', e.data.timeline, e.data.display));
const expRows: Bar[][] = [[], []];
for (const e of experience) expRows[e.data.timeline.row].push(bar(e.data.start, e.data.end, e.data.kind, e.data.timeline, e.data.roles.length === 1 ? e.data.roles[0].display : undefined));

const ticks = Array.from({ length: T1 - T0 }, (_, i) => ({ year: T0 + i, left: pct(T0 + i) }));
const legend = [
  { kind: 'education', label: 'Education' },
  { kind: 'research', label: 'Research' },
  { kind: 'industry', label: 'Industry' },
  { kind: 'teaching', label: 'Teaching' },
];
---

<div class:list={['timeline', { compact }]}>
  <div class="inner horizontal">
    <p class="section-label"><span>▲ Education</span></p>
    <div class="row edu">
      {eduBars.map((b) => (
        <div class:list={['item', b.kind, { ongoing: b.ongoing }]} style={`left:${b.left};width:${b.width}`}>
          <div class:list={['label', { right: b.ongoing }]}>
            {compact ? <span>{b.label.short}</span> : <><strong>{b.label.role}</strong><span>{b.label.org}</span></>}<span class="visually-hidden">, {b.dates}</span>
          </div>
          <div class="bar"></div>
        </div>
      ))}
    </div>
    <div class="axis" aria-hidden="true">
      {ticks.map((t) => <span class="tick" style={`left:${t.left}`}>{t.year}</span>)}
      <span class="now" style={`left:${pct(NOW)}`}></span>
    </div>
    {expRows.map((row) => (
      <div class="row exp">
        {row.map((b) => (
          <div class:list={['item', b.kind, { ongoing: b.ongoing }]} style={`left:${b.left};width:${b.width}`}>
            <div class="bar"></div>
            <div class:list={['label', { right: b.ongoing }]}>
              {compact ? <span>{b.label.short}</span> : <><strong>{b.label.role}</strong><span>{b.label.org}</span></>}<span class="visually-hidden">, {b.dates}</span>
            </div>
          </div>
        ))}
      </div>
    ))}
    <p class="section-label bottom"><span>▼ Experience</span></p>
    <ul class="legend">
      {legend.map((l) => <li><i class={l.kind}></i>{l.label}</li>)}
      {!compact && <li><i class="ongoing-key"></i>Ongoing</li>}
    </ul>
  </div>

  <div class="vertical" style={`--years:${T1 - T0}`}>
    <div class="vhead"><span>Education</span><span></span><span class="span2">Experience</span></div>
    <div class="vgrid">
      <div class="lane vedu">
        {eduBars.map((b) => (
          <div class:list={['vitem', b.kind, { ongoing: b.ongoing }]} style={`top:${b.top};height:${b.height}`}>
            <div class="bar"></div>
            <div class="vlabel">{b.label.short}<span class="visually-hidden">, {b.dates}</span></div>
          </div>
        ))}
      </div>
      <div class="vaxis" aria-hidden="true">
        {ticks.map((t) => <span class="vtick" style={`top:${vpct(t.year + 1)};height:${(100 / (T1 - T0)).toFixed(2)}%`}>{t.year}</span>)}
      </div>
      {expRows.map((row) => (
        <div class="lane vexp">
          {row.map((b) => (
            <div class:list={['vitem', b.kind, { ongoing: b.ongoing }]} style={`top:${b.top};height:${b.height}`}>
              <div class="bar"></div>
              <div class="vlabel">{b.label.short}<span class="visually-hidden">, {b.dates}</span></div>
            </div>
          ))}
        </div>
      ))}
      <span class="vnow" style={`top:${vpct(NOW)}`} aria-hidden="true"></span>
    </div>
    <ul class="legend">
      {legend.map((l) => <li><i class={l.kind}></i>{l.label}</li>)}
      {!compact && <li><i class="ongoing-key"></i>Ongoing</li>}
    </ul>
  </div>
</div>

<style>
  .timeline { overflow-x: auto; padding: 18px 22px 14px; }
  .inner { position: relative; min-width: 960px; }
  .compact .inner { min-width: 820px; }

  .section-label { margin: 0 0 6px; display: flex; align-items: center; gap: 10px; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; }
  .section-label::after { content: ''; flex: 1 1 auto; height: 1px; background: var(--line); }
  .section-label.bottom { margin: 8px 0 0; }

  .row { position: relative; height: 48px; }
  .compact .row { height: 30px; }

  .item { position: absolute; height: 6px; }
  .compact .item { height: 4px; }
  .edu .item { bottom: 4px; }
  .exp .item { top: 4px; }
  .bar { height: 100%; background: var(--kind); box-shadow: inset 0 0 0 1px var(--edge, transparent); transition: filter .15s; }
  .item:hover .bar { filter: brightness(0.8); }
  .ongoing .bar { background: repeating-linear-gradient(-45deg, var(--kind) 0 4px, #fff 4px 6px); }

  .education { --kind: var(--c-education); }
  .research { --kind: var(--c-research); }
  .industry { --kind: var(--c-industry); --edge: var(--c-industry-edge); }
  .teaching { --kind: var(--c-teaching); --edge: var(--c-teaching-edge); }

  .label { position: absolute; white-space: nowrap; line-height: 1.35; left: 0; }
  .label.right { left: auto; right: 0; text-align: right; }
  .edu .label { bottom: 10px; }
  .exp .label { top: 10px; }
  .label strong { display: block; font-size: 12px; font-weight: 500; }
  .label span { display: block; font-size: 11px; color: var(--muted); }
  .compact .label span { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); }
  .compact .edu .label { bottom: 7px; }
  .compact .exp .label { top: 7px; }

  .axis { position: relative; height: 20px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .tick { position: absolute; top: 0; padding-left: 4px; border-left: 1px solid var(--line); font-size: 10px; letter-spacing: 0.12em; line-height: 19px; color: var(--muted); }
  .now { position: absolute; top: -5px; bottom: -5px; border-left: 2px solid var(--c-industry-edge); }

  /* Phones: the same chart turned vertical (newest at the top), so nothing is hidden off to the side. */
  .vertical { display: none; }
  @media (max-width: 640px) {
    .timeline { overflow-x: visible; padding: 16px 16px 12px; }
    .horizontal { display: none; }
    .vertical { display: block; }
  }
  .vhead, .vgrid { display: grid; grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr) minmax(0, 1fr); column-gap: 8px; }
  .vhead { margin-bottom: 8px; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; }
  .vhead span:first-child { text-align: right; }
  .vhead .span2 { grid-column: span 2; border-bottom: 1px solid var(--line); }
  .vhead span:first-child { border-bottom: 1px solid var(--line); }
  .vgrid { position: relative; height: calc(var(--years) * 56px); }
  .compact .vgrid { height: calc(var(--years) * 44px); }
  .lane { position: relative; }
  .vitem { position: absolute; left: 0; right: 0; }
  .vitem .bar { position: absolute; top: 0; bottom: 0; width: 6px; height: auto; }
  .vexp .bar { left: 0; }
  .vedu .bar { right: 0; }
  .ongoing .vitem .bar, .vitem.ongoing .bar { background: repeating-linear-gradient(-45deg, var(--kind) 0 4px, #fff 4px 6px); }
  .vlabel { position: absolute; top: -2px; font-size: 11px; line-height: 1.3; letter-spacing: 0.04em; }
  .vexp .vlabel { left: 12px; right: 0; }
  .vedu .vlabel { right: 12px; left: 0; text-align: right; }
  .vitem.ongoing .vlabel { top: 6px; } /* clear the orange "now" line */
  .vaxis { position: relative; border-left: 1px solid var(--ink); border-right: 1px solid var(--line); }
  .vtick { position: absolute; left: 0; right: 0; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--line); font-size: 10px; letter-spacing: 0.08em; color: var(--muted); }
  .vnow { position: absolute; left: 0; right: 0; border-top: 2px solid var(--c-industry-edge); }

  .legend { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px 18px; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .legend i { display: inline-block; width: 12px; height: 5px; vertical-align: 2px; margin-right: 6px; background: var(--kind); box-shadow: inset 0 0 0 1px var(--edge, transparent); }
  .legend .ongoing-key { background: repeating-linear-gradient(-45deg, var(--muted) 0 4px, #fff 4px 6px); }
</style>
