---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { publications, allTags, splitAuthors } from '../lib/publications';

const years = [...new Set(publications.map((p) => p.year))];
const venueLabel = (p: (typeof publications)[number]) => p.venue;
---

<Base title="Research" description="Publications by Raheeb Hassan: reinforcement learning, world models, hyperdimensional computing and neurosymbolic learning.">
  <div class="wrap">
    <PageTitle kicker="02 · Archive" title="Research">
      <span id="pub-count" role="status">{publications.length} of {publications.length} entries</span> ·
      <a href="https://scholar.google.com/citations?user=73zHDeoAAAAJ">Google Scholar</a>
    </PageTitle>

    <div class="filters" role="group" aria-label="Filter by topic">
      <button type="button" class="chip" data-topic="all" aria-pressed="true"><span class="sq" aria-hidden="true"></span>All</button>
      {allTags.map((t) => (
        <button type="button" class="chip" data-topic={t} aria-pressed="false"><span class="sq" aria-hidden="true"></span>{t}</button>
      ))}
    </div>

    {years.map((year) => {
      const papers = publications.filter((p) => p.year === year);
      return (
        <section class="year" data-year={year} aria-label={`${year}`}>
          <div class="year-head">
            <h2>{year}</h2>
            <span class="line"></span>
            <span class="year-count muted">{papers.length} {papers.length === 1 ? 'entry' : 'entries'}</span>
          </div>
          <div class="grid papers">
            {papers.map((p) => {
              const a = splitAuthors(p.authors);
              const n = publications.length - publications.indexOf(p);
              return (
                <article class="card paper" id={p.id} data-tags={p.tags.join('|')}>
                  <div class="card-head">
                    <span class:list={[{ venue: p.status !== 'preprint' }]}>■ {venueLabel(p)}{p.status === 'accepted' && ' · accepted'}</span>
                    <span>No. {String(n).padStart(2, '0')}</span>
                  </div>
                  <div class="body">
                    <h3>{p.title}</h3>
                    {p.note && <p class="note"><i aria-hidden="true"></i>{p.note}</p>}
                    <p class="authors">{a.before}<strong>{a.mine}</strong>{a.after}</p>
                    {p.summary && <p class="summary">{p.summary}</p>}
                    <div class="foot">
                      <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
                      <div class="links">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</Base>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filters .chip')];
  const papers = [...document.querySelectorAll<HTMLElement>('.paper')];
  const years = [...document.querySelectorAll<HTMLElement>('.year')];
  const count = document.getElementById('pub-count')!;

  function apply(topic: string) {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.topic === topic)));
    let shown = 0;
    papers.forEach((p) => {
      const on = topic === 'all' || (p.dataset.tags ?? '').split('|').includes(topic);
      p.hidden = !on;
      if (on) shown++;
    });
    years.forEach((y) => {
      const n = y.querySelectorAll('.paper:not([hidden])').length;
      y.hidden = n === 0;
      y.querySelector('.year-count')!.textContent = `${n} ${n === 1 ? 'entry' : 'entries'}`;
    });
    count.textContent = `${shown} of ${papers.length} entries`;
  }

  chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.topic!)));
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .year-head { display: flex; align-items: center; gap: 14px; margin: 32px 0 14px; }
  .year-head h2 { margin: 0; font-size: 26px; font-weight: 400; letter-spacing: 0.18em; color: var(--accent-text); }
  .year-head .line { flex: 1 1 auto; height: 1px; background: var(--line); }
  .year-count { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; }
  .papers { grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 14px; }
  .paper[hidden], .year[hidden] { display: none; }
  .card-head .venue { color: var(--accent-text); }
  .card:hover .card-head .venue { color: #fff; }
  .body { padding: 14px 16px 16px; display: flex; flex-direction: column; flex: 1 1 auto; }
  h3 { margin: 0 0 6px; font-size: 16px; font-weight: 500; line-height: 1.5; }
  .note { margin: 0 0 8px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--accent-text); }
  .note i { width: 6px; height: 6px; background: var(--accent); transform: rotate(45deg); flex: 0 0 auto; }
  .authors { margin: 0 0 10px; font-size: 13px; line-height: 1.6; color: var(--muted); }
  .authors strong { color: var(--ink); font-weight: 700; }
  .summary { margin: 0 0 12px; font-size: 14px; line-height: 1.7; padding-left: 12px; border-left: 2px solid var(--sky); }
  .foot { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .links { display: flex; flex-wrap: wrap; gap: 14px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; }
  .paper { scroll-margin-top: 24px; }
  .paper:target { border-color: var(--accent); box-shadow: 4px 4px 0 var(--tint); }
</style>
